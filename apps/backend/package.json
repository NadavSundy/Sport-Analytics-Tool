{
  "name": "@sport-analytics/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:contracts": "npm run build --workspace=@sport-analytics/contracts && npm run build --workspace=@sport-analytics/batch-processing && npm run build --workspace=@sport-analytics/object-storage && node ../../scripts/check-contracts-public-api.mjs",
    "predev": "npm run prepare:contracts",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run prepare:contracts",
    "build": "tsc -p tsconfig.json && node scripts/copy-openapi-spec.mjs",
    "start": "node dist/index.js",
    "lint": "eslint src tests --ext .ts",
    "pretypecheck": "npm run prepare:contracts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --workspace=@sport-analytics/contracts && npm run test:unit && npm run test:api",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api tests/auth.test.ts tests/authorization.test.ts tests/health.test.ts",
    "test:contract": "vitest run tests/contract",
    "test:database": "tsx scripts/run-database-tests.ts",
    "measure:performance": "tsx scripts/run-performance-benchmark.ts",
    "measure:aggregate-snapshots": "tsx scripts/measure-aggregate-snapshots.ts",
    "measure:public-read-workloads": "tsx scripts/measure-public-read-workloads.ts",
    "pretest:database:run": "npm run prepare:contracts",
    "test:database:run": "cross-env NODE_ENV=test vitest run tests/database",
    "test:coverage": "vitest run --coverage tests/unit tests/api tests/auth.test.ts tests/authorization.test.ts tests/health.test.ts",
    "db:check": "tsx --env-file=.env scripts/check-connection.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:latency": "tsx --env-file=.env scripts/latency.ts",
    "db:import": "tsx --env-file=.env scripts/import-corpus.ts",
    "db:ingest": "tsx --env-file=.env scripts/ingest-match.ts",
    "db:validate": "tsx --env-file=.env scripts/validate-match.ts",
    "db:sql": "tsx --env-file=.env scripts/sql.ts",
    "db:migrate": "cross-env NODE_EXTRA_CA_CERTS=certs/supabase-ca.crt node-pg-migrate up --envPath .env --migrations-dir ../../database/migrations --ignore-pattern \"README.md\" --reject-unauthorized true",
    "db:migrate:down": "cross-env NODE_EXTRA_CA_CERTS=certs/supabase-ca.crt node-pg-migrate down --envPath .env --migrations-dir ../../database/migrations --ignore-pattern \"README.md\" --reject-unauthorized true",
    "db:migrate:dry": "cross-env NODE_EXTRA_CA_CERTS=certs/supabase-ca.crt node-pg-migrate up --envPath .env --migrations-dir ../../database/migrations --ignore-pattern \"README.md\" --reject-unauthorized true --dry-run",
    "db:migrate:create": "node-pg-migrate create --migrations-dir ../../database/migrations --ignore-pattern \"README.md\" --migration-filename-format utc -j sql",
    "db:test:migrate": "cross-env NODE_ENV=test node-pg-migrate up --database-url-var DATABASE_URL_TEST --migrations-dir ../../database/migrations --ignore-pattern \"README.md\" --no-verbose",
    "db:test:reset": "cross-env NODE_ENV=test tsx scripts/reset-test-database.ts",
    "db:test:seed": "cross-env NODE_ENV=test tsx scripts/seed-test-database.ts"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@azure/storage-blob": "^12.27.0",
    "@sport-analytics/batch-processing": "0.1.0",
    "@sport-analytics/contracts": "0.1.0",
    "@sport-analytics/object-storage": "0.1.0",
    "@supabase/supabase-js": "^2.112.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pg": "^8.22.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "embedded-postgres": "^16.14.0-beta.17",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.7",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
