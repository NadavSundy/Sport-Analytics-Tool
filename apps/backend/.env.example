NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=local
PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sport_analytics
# Production must supply a unique secret of at least 32 characters. Local development uses a
# process-local fallback only when this is omitted.
# ANONYMOUS_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ANONYMOUS_RATE_LIMIT_PER_MINUTE=30
ANONYMOUS_GLOBAL_RATE_LIMIT_PER_MINUTE=600
# Keep 0 for direct local connections; Container Apps uses one trusted ingress hop.
TRUST_PROXY_HOPS=0
# Bound on how long one PostgreSQL statement may run before the server cancels it. An
# unbounded statement exhausts the ten-connection pool rather than merely being slow.
# 1000-120000 ms; defaults to 15000 when unset.
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Public Supabase project configuration used for authentication.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional at startup; required to enable server-side Supabase Auth account deletion.
# SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key

# Natural-language query provider (ADR-017). Server-only: the key must never reach the frontend
# bundle, and scripts/check-frontend-bundle-secrets.mjs guards that. Optional in every
# environment: without it the backend starts, logs one startup warning, and only
# natural-language querying is disabled. Replace the placeholder with the workspace-scoped key
# from the project Console workspace, and never commit a real value.
# LLM_API_KEY=your-server-only-anthropic-api-key
# The model identifier and the per-request bound are configuration, not secrets.
# LLM_TIMEOUT_MS accepts 2000 to 60000 milliseconds and defaults to 15000 when unset.
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=15000

# Local dataset release artifacts are streamed here. This resolves from apps/backend when using
# npm workspace commands and is ignored by Git.
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_FILESYSTEM_ROOT=../../.local/object-storage

# Production must replace OBJECT_STORAGE_PROVIDER above with azure. These values identify private
# Azure resources and are not credentials. Authentication uses DefaultAzureCredential/managed identity.
# OBJECT_STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT_NAME=statsthegameblobdev
# AZURE_STORAGE_CONTAINER_NAME=staged-ingestion
# AZURE_STORAGE_INGESTION_CONTAINER_NAME=staged-ingestion
# AZURE_STORAGE_RELEASE_CONTAINER_NAME=dataset-releases

# Weather integration (GET /api/v1/weather), backed by Open-Meteo.
# Open-Meteo requires no API key, account or secret — no configuration needed here.
# See docs/api/weather.md and evidence/decisions/ADR-008-external-weather-api-integration.md.
#
# Fixture weather (GET /api/v1/fixtures/{fixtureId}/weather) additionally geocodes venue
# names/cities to coordinates via Open-Meteo's geocoding API. Like the weather endpoints above,
# this requires no API key, account or secret. See "Location-to-coordinate resolution" in
# docs/api/weather.md.


API_VERSION=v1

CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=debug


# Dedicated isolated test database.
# This must never point to the development or production database.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/sport_analytics_test
