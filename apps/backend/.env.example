NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sport_analytics
# Public Supabase project configuration used for authentication.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only elevated credential for Supabase Auth administrative operations.
# Never use a VITE_ prefix or expose this value to frontend code or responses.
SUPABASE_SECRET_KEY=your-supabase-secret-or-legacy-service-role-key
# Add only server-side external API credentials here.
EXTERNAL_API_KEY=


API_VERSION=v1

CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=debug


# Dedicated isolated test database.
# This must never point to the development or production database.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/sport_analytics_test
