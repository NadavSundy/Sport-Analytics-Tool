{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdp.ms.wits.ac.za/git-push-pray/Sport-Analytics-Tool/testing/user-feedback/schema.json",
  "title": "Sprint 2 user-testing feedback store",
  "description": "An anonymised, normalised store of formal user-testing responses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "responses"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response"
      }
    }
  },
  "$defs": {
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "role", "sessionDate", "importSource", "tasks"],
      "properties": {
        "participantId": {
          "type": "string",
          "pattern": "^P(?:0[1-9]|[1-9][0-9]*)$",
          "description": "Anonymous participant identifier only; for example P01."
        },
        "role": {
          "type": "string",
          "enum": ["public", "submitter", "administrator"]
        },
        "sessionDate": {
          "type": "string",
          "format": "date"
        },
        "importSource": {
          "type": "string",
          "enum": ["manual", "microsoft_forms_csv"]
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "postTestResponses": {
          "$ref": "#/$defs/postTestResponses"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "outcome", "observations", "findings"],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^(?:PUB|SUB|ADM)-[0-9]{2}$"
        },
        "outcome": {
          "type": "string",
          "enum": ["success", "partial", "failure"]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "summary", "severity", "decision", "retestRequired"],
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^F[0-9]{2,}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "type": "string",
          "enum": ["S1", "S2", "S3", "S4"]
        },
        "decision": {
          "type": "string",
          "enum": [
            "bug_issue_created",
            "ux_improvement_issue_created",
            "feature_request_created",
            "existing_issue_linked",
            "accepted_and_fixed_immediately",
            "no_change"
          ]
        },
        "relatedIssue": {
          "type": "string",
          "pattern": "^#[0-9]+$"
        },
        "decisionReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retestRequired": {
          "type": "boolean"
        }
      }
    },
    "postTestResponses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mostConfusing": {
          "$ref": "#/$defs/freeText"
        },
        "couldNotFind": {
          "$ref": "#/$defs/freeText"
        },
        "unclearTerminology": {
          "$ref": "#/$defs/freeText"
        },
        "mostIntuitive": {
          "$ref": "#/$defs/freeText"
        },
        "oneChange": {
          "$ref": "#/$defs/freeText"
        },
        "comfortableRepeatingTasks": {
          "type": "boolean"
        }
      }
    },
    "freeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "x-microsoft-forms-csv": {
    "normalisedStore": "One response object per participant session; task columns are grouped into the tasks array.",
    "requiredColumns": {
      "Participant ID": "participantId",
      "Role": "role",
      "Session date": "sessionDate"
    },
    "excludedColumns": ["Name", "Email", "Start time", "Completion time"]
  }
}
